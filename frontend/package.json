{
  "name": "documind-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "bff": "node --watch server/index.mjs",
    "start": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "test": "vitest run && node --test server/app.test.mjs",
