# Optional: image pinning metadata (examples)
# Repo digests may be empty for locally-built images.
# Preferred: pull/push via registry and set BACKEND_IMAGE/FRONTEND_IMAGE to name@sha256:...
# Fallback: use tags and verify local image IDs with `docker image inspect --format '{{.Id}}'`.

# Example (registry digest pin):
# BACKEND_IMAGE=registry.example.com/documind-public-beta-backend@sha256:...
# FRONTEND_IMAGE=registry.example.com/documind-public-beta-frontend@sha256:...

# Example (local build on VPS, tag pin + verify Id):
# BACKEND_IMAGE=documind-public-beta-backend:2026-10-31
# FRONTEND_IMAGE=documind-public-beta-frontend:2026-10-31
# EXPECT_BACKEND_IMAGE_ID=sha256:...
# EXPECT_FRONTEND_IMAGE_ID=sha256:...
