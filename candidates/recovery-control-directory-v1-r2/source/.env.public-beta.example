# DocuMind AI — Public beta (5 testeurs) — Exemple d'environnement (SANS SECRETS)
# Copier en `.env.public-beta` sur le VPS et remplacer les valeurs ***.

APP_HOST=beta.example.com

# Images (tag OU digest). Voir aussi `.env.public-beta.images.example`.
BACKEND_IMAGE=documind-public-beta-backend:2026-10-31
FRONTEND_IMAGE=documind-public-beta-frontend:2026-10-31
POSTGRES_IMAGE=documind-postgres-vector:17

# DB dédiée
POSTGRES_DB=documind_public_beta
POSTGRES_USER=documind_public_beta
POSTGRES_PASSWORD=***

# Public mode
APPLICATION_PROFILE=standard
REGISTRATION_MODE=public
PUBLIC_REGISTRATION_LIMIT=5
PUBLIC_REGISTRATION_PER_HOUR=10

# Security toggles
AI_ENABLED=false
OWNER_DEMO_ENABLED=false
LEGACY_API_ENABLED=false
API_KEYS={}

# BFF credential (>=32 chars, no spaces)
BFF_SERVICE_KEY=***

# Legal / operator identity (required in public mode)
PUBLIC_LEGAL_READY=true
PUBLIC_OPERATOR_NAME=***
PUBLIC_CONTACT_EMAIL=contact@example.com
PUBLIC_TERMS_VERSION=public-beta-2026-10
PUBLIC_LEGAL_NOTICE_URL=https://beta.example.com/legal-notice
PUBLIC_PRIVACY_URL=https://beta.example.com/privacy
PUBLIC_TERMS_URL=https://beta.example.com/terms

# Base URL must be an HTTPS origin (no path)
ACCOUNT_BASE_URL=https://beta.example.com

# SMTP
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_FROM=no-reply@example.com
SMTP_USERNAME=***
SMTP_PASSWORD=***

# Reverse proxy trust (Traefik container IP on the docker network)
BFF_TRUSTED_PROXY_IPS=***

# Candidate directory v1; provision separately, never reuse the restored proof.
RECOVERY_CONTROL_VERSION=1
RECOVERY_CONTROL_DIR=/opt/documind-public-beta/recovery-control
RECOVERY_READER_GID=

# Lifecycle (explicit store/key paths; no secrets)
LIFECYCLE_DATA_ROOT=/app/lifecycle
LIFECYCLE_BACKUP_LOCK_PATH=/app/lifecycle/.backup.lock
LIFECYCLE_REGISTRY_PATH=/app/lifecycle/registry.sqlite
LIFECYCLE_CONFIRMATION_PATH=/app/lifecycle/confirmation.sqlite
LIFECYCLE_AUTHENTICATED_CONFIRMATION_PATH=/app/lifecycle/authenticated-confirmation.sqlite
LIFECYCLE_HOLDS_PATH=/app/lifecycle/holds.sqlite
LIFECYCLE_ADMISSION_ANCHOR_PATH=/app/lifecycle/admission-anchor.sqlite
LIFECYCLE_AUTHENTICATION_KEY_PATH=/app/lifecycle/keys/authentication.key
LIFECYCLE_ADMISSION_KEY_PATH=/app/lifecycle/keys/admission.key


# Optional: gate registration endpoints to trusted IPs only
# REGISTRATION_GATE_SOURCE_RANGE=203.0.113.10/32,203.0.113.11/32
UI_ENVIRONMENT_LABEL=Bêta
