{
  "compose.yaml": {
    "services": {
      "db": {
        "build": {
          "context": ".",
          "dockerfile": "Dockerfile.db"
        },
        "image": "documind-postgres-vector:17",
        "environment": {
          "POSTGRES_USER": "${POSTGRES_USER:-documind}",
          "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD:-documind}",
          "POSTGRES_DB": "${POSTGRES_DB:-documind}"
        },
        "ports": [
          "127.0.0.1:5432:5432"
        ],
        "volumes": [
          "postgres_data:/var/lib/postgresql/data"
        ],
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"
          ],
          "interval": "5s",
          "timeout": "5s",
          "retries": 10
        }
      },
      "api": {
        "build": ".",
        "env_file": ".env",
        "environment": {
          "DATABASE_URL": "postgresql+psycopg://${POSTGRES_USER:-documind}:${POSTGRES_PASSWORD:-documind}@db:5432/${POSTGRES_DB:-documind}",
          "STORAGE_DIR": "/app/var/documents",
          "LIFECYCLE_DATA_ROOT": "/app/lifecycle",
          "LIFECYCLE_BACKUP_LOCK_PATH": "/app/lifecycle/.backup.lock",
          "EXTRACTION_MODE": "sandbox"
        },
        "ports": [
          "127.0.0.1:${API_PORT:-8000}:8000"
        ],
        "volumes": [
          "documents:/app/var",
          "lifecycle:/app/lifecycle"
        ],
        "depends_on": {
          "db": {
            "condition": "service_healthy"
          }
        },
        "mem_limit": "1536m",
        "cpus": 2,
        "pids_limit": 64,
        "init": true,
        "command": [
          "sh",
          "-c",
          "alembic upgrade head && exec uvicorn backend.main:app --host 0.0.0.0 --port 8000 --limit-concurrency 32 --timeout-keep-alive 5"
        ],
        "healthcheck": {
          "test": [
            "CMD",
            "python",
            "-c",
            "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health', timeout=3)"
          ],
          "interval": "10s",
          "timeout": "5s",
          "start_period": "20s",
          "retries": 5
        }
      },
      "web": {
        "build": "./frontend",
        "environment": {
          "API_KEYS": "${API_KEYS:-}",
          "BFF_API_KEY": "${BFF_API_KEY:-}",
          "BFF_SERVICE_KEY": "${BFF_SERVICE_KEY:-}",
          "BFF_BACKEND_URL": "http://api:8000",
          "BFF_HOST": "0.0.0.0",
          "BFF_PORT": 3000,
          "MAX_UPLOAD_BYTES": "${MAX_UPLOAD_BYTES:-10485760}",
          "WORKER_TIMEOUT_SECONDS": "${WORKER_TIMEOUT_SECONDS:-30}",
          "AI_TIMEOUT_SECONDS": "${AI_TIMEOUT_SECONDS:-30}",
          "AI_MAX_SUMMARY_STEPS": "${AI_MAX_SUMMARY_STEPS:-5}",
          "DOCUMIND_GATEWAY_TOKEN": "${DOCUMIND_GATEWAY_TOKEN:-}"
        },
        "ports": [
          "127.0.0.1:${WEB_PORT:-3000}:3000"
        ],
        "depends_on": {
          "api": {
            "condition": "service_healthy"
          }
        },
        "mem_limit": "512m",
        "cpus": 1,
        "pids_limit": 64,
        "init": true
      },
      "https": {
        "image": "caddy:2-alpine",
        "profiles": [
          "https"
        ],
        "environment": {
          "DOCUMIND_GATEWAY_TOKEN": "${DOCUMIND_GATEWAY_TOKEN:-}"
        },
        "ports": [
          "127.0.0.1:8443:443"
        ],
        "volumes": [
          "./Caddyfile:/etc/caddy/Caddyfile:ro",
          "caddy_data:/data",
          "caddy_config:/config"
        ],
        "depends_on": {
          "web": {
            "condition": "service_started"
          }
        }
      }
    },
    "volumes": {
      "postgres_data": null,
      "documents": null,
      "lifecycle": null,
      "caddy_data": null,
      "caddy_config": null
    }
  },
  "compose.production.yaml": {
    "name": "documind-prod",
    "services": {
      "db": {
        "image": "${POSTGRES_IMAGE:?Supply the PostgreSQL pgvector image digest from a CI release}",
        "labels": {
          "traefik.enable": "false"
        },
        "environment": {
          "POSTGRES_DB": "documind",
          "POSTGRES_USER": "documind",
          "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD:?Configure a production database password}"
        },
        "volumes": [
          "production_database:/var/lib/postgresql/data"
        ],
        "networks": [
          "data"
        ],
        "mem_limit": "1g",
        "cpus": 1,
        "pids_limit": 128,
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "pg_isready -U documind -d documind"
          ],
          "interval": "10s",
          "timeout": "5s",
          "retries": 10
        },
        "logging": {
          "driver": "json-file",
          "options": {
            "max-size": "10m",
            "max-file": "3"
          }
        }
      },
      "api": {
        "image": "${BACKEND_IMAGE:?Supply the backend image digest from a CI release}",
        "labels": {
          "traefik.enable": "false"
        },
        "env_file": "${PRODUCTION_ENV_FILE:-.env.production}",
        "environment": {
          "DATABASE_URL": "postgresql+psycopg://documind:${POSTGRES_PASSWORD:?}@db:5432/documind",
          "ACCOUNT_BASE_URL": "https://${APP_HOST:?Set the production DNS hostname}",
          "STORAGE_DIR": "/app/var/documents",
          "MAX_UPLOAD_BYTES": "${MAX_UPLOAD_BYTES:-10485760}",
          "UPLOAD_MAX_CONCURRENT": "${UPLOAD_MAX_CONCURRENT:-2}",
          "UPLOAD_MAX_PER_OWNER": "${UPLOAD_MAX_PER_OWNER:-1}",
          "UPLOAD_MAX_PREFLIGHTS": "${UPLOAD_MAX_PREFLIGHTS:-8}",
          "UPLOAD_TEMP_BUDGET_BYTES": "${UPLOAD_TEMP_BUDGET_BYTES:-67108864}",
          "UPLOAD_MIN_FREE_BYTES": "${UPLOAD_MIN_FREE_BYTES:-33554432}",
          "UPLOAD_AUTH_TIMEOUT_SECONDS": "${UPLOAD_AUTH_TIMEOUT_SECONDS:-3}",
          "UPLOAD_READ_TIMEOUT_SECONDS": "${UPLOAD_READ_TIMEOUT_SECONDS:-30}",
          "UPLOAD_IDLE_TIMEOUT_SECONDS": "${UPLOAD_IDLE_TIMEOUT_SECONDS:-5}",
          "EXTRACTION_MODE": "sandbox",
          "MAX_CONCURRENT_WORKERS": "2",
          "WORKER_MEMORY_MB": "512",
          "WORKER_TIMEOUT_SECONDS": "30",
          "API_KEYS": "{}",
          "LEGACY_API_ENABLED": "false",
          "BFF_SERVICE_KEY": "${BFF_SERVICE_KEY:?Configure an independent service credential}",
          "REGISTRATION_MODE": "${REGISTRATION_MODE:-disabled}",
          "LIFECYCLE_DATA_ROOT": "/app/lifecycle",
          "LIFECYCLE_BACKUP_LOCK_PATH": "/app/lifecycle/.backup.lock"
        },
        "volumes": [
          "production_documents:/app/var",
          "production_lifecycle:/app/lifecycle"
        ],
        "networks": [
          "data",
          "application",
          "outbound"
        ],
        "depends_on": {
          "db": {
            "condition": "service_healthy"
          }
        },
        "mem_limit": "1536m",
        "cpus": 2,
        "pids_limit": 64,
        "init": true,
        "stop_grace_period": "150s",
        "security_opt": [
          "no-new-privileges:true"
        ],
        "read_only": true,
        "tmpfs": [
          "/tmp:size=256m,mode=1777"
        ],
        "command": [
          "uvicorn",
          "backend.main:app",
          "--host",
          "0.0.0.0",
          "--port",
          "8000",
          "--workers",
          "1",
          "--no-access-log",
          "--limit-concurrency",
          "32"
        ],
        "healthcheck": {
          "test": [
            "CMD",
            "python",
            "-c",
            "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health',timeout=3)"
          ],
          "interval": "10s",
          "timeout": "5s",
          "start_period": "30s",
          "retries": 5
        },
        "logging": {
          "driver": "json-file",
          "options": {
            "max-size": "10m",
            "max-file": "3"
          }
        }
      },
      "web": {
        "image": "${FRONTEND_IMAGE:?Supply the frontend image digest from a CI release}",
        "environment": {
          "BFF_SERVICE_KEY": "${BFF_SERVICE_KEY:?}",
          "BFF_BACKEND_URL": "http://api:8000",
          "BFF_HOST": "0.0.0.0",
          "BFF_PORT": 3000,
          "BFF_ALLOWED_HOSTS": "${APP_HOST:?Set the production DNS hostname}",
          "BFF_TRUSTED_PROXY_IPS": "${BFF_TRUSTED_PROXY_IPS:?Resolve the actual Traefik address on web before deployment}",
          "MAX_UPLOAD_BYTES": "${MAX_UPLOAD_BYTES:-10485760}",
          "UPLOAD_MAX_CONCURRENT": "${UPLOAD_MAX_CONCURRENT:-2}",
          "UPLOAD_MAX_PREFLIGHTS": "${UPLOAD_MAX_PREFLIGHTS:-8}",
          "UPLOAD_AUTH_TIMEOUT_SECONDS": "${UPLOAD_AUTH_TIMEOUT_SECONDS:-3}",
          "UPLOAD_READ_TIMEOUT_SECONDS": "${UPLOAD_READ_TIMEOUT_SECONDS:-30}",
          "UPLOAD_IDLE_TIMEOUT_SECONDS": "${UPLOAD_IDLE_TIMEOUT_SECONDS:-5}",
          "UPLOAD_TOTAL_TIMEOUT_SECONDS": "${UPLOAD_TOTAL_TIMEOUT_SECONDS:-75}",
          "WORKER_TIMEOUT_SECONDS": "${WORKER_TIMEOUT_SECONDS:-30}",
          "AI_TIMEOUT_SECONDS": "${AI_TIMEOUT_SECONDS:-30}",
          "AI_MAX_SUMMARY_STEPS": "${AI_MAX_SUMMARY_STEPS:-5}"
        },
        "networks": [
          "application",
          "web"
        ],
        "labels": {
          "traefik.enable": "true",
          "traefik.docker.network": "web",
          "traefik.http.routers.documind-ai.rule": "Host(`${APP_HOST:?Set the production DNS hostname}`)",
          "traefik.http.routers.documind-ai.entrypoints": "websecure",
          "traefik.http.routers.documind-ai.tls": "true",
          "traefik.http.routers.documind-ai.tls.certresolver": "letsencrypt",
          "traefik.http.routers.documind-ai.service": "documind-ai",
          "traefik.http.routers.documind-ai.middlewares": "documind-ai-headers@docker",
          "traefik.http.routers.documind-ai-upload.rule": "Host(`${APP_HOST:?Set the production DNS hostname}`) && Method(`POST`) && Path(`/bff/documents`)",
          "traefik.http.routers.documind-ai-upload.entrypoints": "websecure",
          "traefik.http.routers.documind-ai-upload.tls": "true",
          "traefik.http.routers.documind-ai-upload.tls.certresolver": "letsencrypt",
          "traefik.http.routers.documind-ai-upload.service": "documind-ai",
          "traefik.http.routers.documind-ai-upload.priority": "100",
          "traefik.http.routers.documind-ai-upload.middlewares": "documind-ai-headers@docker,documind-ai-upload-capacity@docker",
          "traefik.http.middlewares.documind-ai-upload-capacity.inflightreq.amount": "${UPLOAD_MAX_PREFLIGHTS:-8}",
          "traefik.http.middlewares.documind-ai-upload-capacity.inflightreq.sourcecriterion.requesthost": "true",
          "traefik.http.services.documind-ai.loadbalancer.server.port": "3000",
          "traefik.http.services.documind-ai.loadbalancer.passhostheader": "true",
          "traefik.http.middlewares.documind-ai-headers.headers.customrequestheaders.X-Forwarded-Proto": "https",
          "traefik.http.middlewares.documind-ai-headers.headers.contenttypenosniff": "true",
          "traefik.http.middlewares.documind-ai-headers.headers.referrerpolicy": "no-referrer",
          "traefik.http.middlewares.documind-ai-headers.headers.stsseconds": "31536000"
        },
        "depends_on": {
          "api": {
            "condition": "service_healthy"
          }
        },
        "mem_limit": "512m",
        "cpus": 1,
        "pids_limit": 64,
        "init": true,
        "read_only": true,
        "security_opt": [
          "no-new-privileges:true"
        ],
        "tmpfs": [
          "/tmp:size=32m"
        ],
        "healthcheck": {
          "test": [
            "CMD",
            "node",
            "server/healthcheck.mjs"
          ],
          "interval": "15s",
          "timeout": "5s",
          "retries": 5
        },
        "logging": {
          "driver": "json-file",
          "options": {
            "max-size": "10m",
            "max-file": "3"
          }
        }
      }
    },
    "networks": {
      "data": {
        "internal": true
      },
      "application": {
        "internal": true
      },
      "web": {
        "external": true,
        "name": "web"
      },
      "outbound": {}
    },
    "volumes": {
      "production_database": {},
      "production_documents": {},
      "production_lifecycle": {}
    }
  },
  "compose.public-beta.vps.yaml": {
    "name": "documind-public-beta",
    "services": {
      "db": {
        "image": "${POSTGRES_IMAGE:-documind-postgres-vector:17}",
        "labels": {
          "traefik.enable": "false"
        },
        "environment": {
          "POSTGRES_DB": "${POSTGRES_DB:-documind_public_beta}",
          "POSTGRES_USER": "${POSTGRES_USER:-documind_public_beta}",
          "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD:?Set a dedicated PostgreSQL password}"
        },
        "volumes": [
          "public_beta_database:/var/lib/postgresql/data"
        ],
        "networks": [
          "data"
        ],
        "mem_limit": "1g",
        "cpus": 1,
        "pids_limit": 128,
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"
          ],
          "interval": "10s",
          "timeout": "5s",
          "retries": 10
        },
        "logging": {
          "driver": "json-file",
          "options": {
            "max-size": "10m",
            "max-file": "3"
          }
        }
      },
      "lifecycle-init": {
        "image": "${BACKEND_IMAGE:?Set BACKEND_IMAGE (tag or digest)}",
        "labels": {
          "traefik.enable": "false"
        },
        "user": "0:0",
        "env_file": [
          "${PUBLIC_BETA_ENV_FILE:-.env.public-beta}"
        ],
        "environment": {
          "DATABASE_URL": "postgresql+psycopg://${POSTGRES_USER:-documind_public_beta}:${POSTGRES_PASSWORD:?}@db:5432/${POSTGRES_DB:-documind_public_beta}",
          "STORAGE_DIR": "/app/var/documents",
          "EXTRACTION_MODE": "sandbox",
          "MAX_CONCURRENT_WORKERS": "2",
          "WORKER_MEMORY_MB": "512",
          "WORKER_TIMEOUT_SECONDS": "30",
          "API_KEYS": "{}",
          "LEGACY_API_ENABLED": "false",
          "AI_ENABLED": "false",
          "OWNER_DEMO_ENABLED": "false",
          "LIFECYCLE_DATA_ROOT": "/app/lifecycle",
          "LIFECYCLE_BACKUP_LOCK_PATH": "/app/lifecycle/.backup.lock",
          "LIFECYCLE_REGISTRY_PATH": "/app/lifecycle/registry/registry.sqlite",
          "LIFECYCLE_CONFIRMATION_PATH": "/app/lifecycle/confirmation/confirmation.sqlite",
          "LIFECYCLE_AUTHENTICATED_CONFIRMATION_PATH": "/app/lifecycle/authenticated/authenticated-confirmation.sqlite",
          "LIFECYCLE_HOLDS_PATH": "/app/lifecycle/holds/holds.sqlite",
          "LIFECYCLE_ADMISSION_ANCHOR_PATH": "/app/lifecycle/admissions/admission-anchor.sqlite",
          "LIFECYCLE_AUTHENTICATION_KEY_PATH": "/app/lifecycle/keys/authentication.key",
          "LIFECYCLE_ADMISSION_KEY_PATH": "/app/lifecycle/keys/admission.key"
        },
        "volumes": [
          "public_beta_lifecycle:/app/lifecycle"
        ],
        "networks": [
          "data"
        ],
        "depends_on": {
          "db": {
            "condition": "service_healthy"
          }
        },
        "read_only": true,
        "cap_drop": [
          "ALL"
        ],
        "cap_add": [
          "CHOWN",
          "FOWNER",
          "DAC_OVERRIDE",
          "SETUID",
          "SETGID"
        ],
        "security_opt": [
          "no-new-privileges:true"
        ],
        "init": true,
        "entrypoint": [
          "python"
        ],
        "command": [
          "-c",
          "import os\nimport secrets\nimport pwd\nfrom pathlib import Path\n\nfrom backend.lifecycle_admissions import AdmissionAnchor\nfrom backend.lifecycle_authenticated import AuthenticatedConfirmationStore\nfrom backend.lifecycle_durability import ConfirmationStore\nfrom backend.lifecycle_holds import HoldStore\nfrom backend.lifecycle_registry import Registry\n\napp = pwd.getpwnam('app')\napp_uid, app_gid = app.pw_uid, app.pw_gid\n\nroot = Path(os.environ['LIFECYCLE_DATA_ROOT'])\nlock_path = Path(os.environ['LIFECYCLE_BACKUP_LOCK_PATH'])\n\nregistry = Path(os.environ['LIFECYCLE_REGISTRY_PATH'])\nwitness = Path(os.environ['LIFECYCLE_CONFIRMATION_PATH'])\nauth_path = Path(os.environ['LIFECYCLE_AUTHENTICATED_CONFIRMATION_PATH'])\nholds = Path(os.environ['LIFECYCLE_HOLDS_PATH'])\nanchor = Path(os.environ['LIFECYCLE_ADMISSION_ANCHOR_PATH'])\n\nstore_paths = [registry, witness, auth_path, holds, anchor]\n\ndef chmod(path: Path, mode: int) -> None:\n  os.chmod(path, mode, follow_symlinks=False)\n\ndef chown(path: Path, uid: int, gid: int) -> None:\n  os.chown(path, uid, gid, follow_symlinks=False)\n\ndef stat_owner(path: Path):\n  st = os.stat(path, follow_symlinks=False)\n  return st.st_uid, st.st_gid, st.st_mode & 0o777\n\ndef ensure_dir(path: Path, *, uid: int, gid: int, mode: int) -> None:\n  path.mkdir(parents=True, exist_ok=True)\n  if path.is_symlink():\n    raise ValueError(f\"Unsafe lifecycle directory: {path}\")\n  current_uid, current_gid, _ = stat_owner(path)\n  if (current_uid, current_gid) != (uid, gid):\n    chown(path, uid, gid)\n  chmod(path, mode)\n\ndef ensure_file_owner(path: Path, *, uid: int, gid: int, mode: int, allow_root_fixup: bool) -> None:\n  if not path.exists():\n    return\n  if path.is_symlink():\n    raise ValueError(f\"Unsafe lifecycle file: {path}\")\n  current_uid, current_gid, _ = stat_owner(path)\n  if (current_uid, current_gid) == (uid, gid):\n    chmod(path, mode)\n    return\n  if allow_root_fixup and current_uid == 0:\n    # Fix a partial provisioning that created stores as root.\n    chown(path, uid, gid)\n    chmod(path, mode)\n    return\n  raise ValueError(f\"Owner mismatch for {path}: {current_uid}:{current_gid} (expected {uid}:{gid})\")\n\nprint(f\"[lifecycle-init] pre ids uid={os.getuid()} gid={os.getgid()}\")\n\n# Privileged step: create dirs and keys, and (idempotently) fix wrong root-owned stores/lock.\nensure_dir(root, uid=app_uid, gid=app_gid, mode=0o700)\n# Migrate legacy store locations (flat files under /app/lifecycle) into separate directories.\n# This preserves store bytes (rename) and enables backend.lifecycle_snapshot invariants.\nlegacy_map = {\n  root/'registry.sqlite': registry,\n  root/'confirmation.sqlite': witness,\n  root/'authenticated-confirmation.sqlite': auth_path,\n  root/'holds.sqlite': holds,\n  root/'admission-anchor.sqlite': anchor,\n}\n\nfor legacy, current in legacy_map.items():\n  if legacy.exists() and not current.exists():\n    ensure_dir(current.parent, uid=app_uid, gid=app_gid, mode=0o700)\n    os.rename(legacy, current)\n\nfor p in store_paths:\n  ensure_dir(p.parent, uid=app_uid, gid=app_gid, mode=0o700)\n  ensure_file_owner(p, uid=app_uid, gid=app_gid, mode=0o600, allow_root_fixup=True)\n\nensure_dir(lock_path.parent, uid=app_uid, gid=app_gid, mode=0o700)\nensure_file_owner(lock_path, uid=app_uid, gid=app_gid, mode=0o600, allow_root_fixup=True)\n\nkeys_dir = Path(os.environ['LIFECYCLE_AUTHENTICATION_KEY_PATH']).parent\nensure_dir(keys_dir, uid=0, gid=app_gid, mode=0o750)\n\ndef ensure_key(path: Path) -> None:\n  if path.exists():\n    # Preserve existing keys; only enforce the expected perms.\n    ensure_file_owner(path, uid=0, gid=app_gid, mode=0o440, allow_root_fixup=False)\n    return\n  fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)\n  try:\n    os.write(fd, secrets.token_bytes(32))\n  finally:\n    os.close(fd)\n  chown(path, 0, app_gid)\n  chmod(path, 0o440)\n\nensure_key(Path(os.environ['LIFECYCLE_AUTHENTICATION_KEY_PATH']))\nensure_key(Path(os.environ['LIFECYCLE_ADMISSION_KEY_PATH']))\n\n# Drop privileges: all SQLite stores MUST be created/initialized as `app`.\ntry:\n  os.setgroups([app_gid])\nexcept Exception:\n  pass\nos.setgid(app_gid)\nos.setuid(app_uid)\nos.umask(0o077)\n\nprint(f\"[lifecycle-init] post ids uid={os.getuid()} gid={os.getgid()}\")\n\n# Idempotent initialization: never overwrite existing stores.\nif not registry.exists():\n  Registry(registry).initialize()\nif not witness.exists():\n  ConfirmationStore(witness).initialize()\n\nauth = AuthenticatedConfirmationStore(\n  auth_path,\n  Path(os.environ['LIFECYCLE_AUTHENTICATION_KEY_PATH']).read_bytes(),\n  os.environ.get('LIFECYCLE_AUTHENTICATED_NAMESPACE', 'documind-public-beta'),\n)\nif not auth_path.exists():\n  auth.initialize()\n\nif not holds.exists():\n  HoldStore(holds, auth).initialize()\n\nif not anchor.exists():\n  AdmissionAnchor(anchor, Path(os.environ['LIFECYCLE_ADMISSION_KEY_PATH']).read_bytes()).initialize()\n\n# Ensure lock exists and is owned by `app` (no chmod/chown possible after setuid).\nif not lock_path.exists():\n  fd = os.open(lock_path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)\n  os.close(fd)\ncurrent_uid, current_gid, _ = stat_owner(lock_path)\nif (current_uid, current_gid) != (app_uid, app_gid):\n  raise ValueError(f\"Lock owner mismatch for {lock_path}: {current_uid}:{current_gid} (expected {app_uid}:{app_gid})\")\nchmod(lock_path, 0o600)\n\n# Final verification: owners must match effective uid.\nfor p in store_paths:\n  puid, pgid, pmode = stat_owner(p)\n  duid, dgid, dmode = stat_owner(p.parent)\n  print(f\"[lifecycle-init] {p} file={puid}:{pgid} {oct(pmode)} dir={duid}:{dgid} {oct(dmode)}\")\n  if puid != app_uid or duid != app_uid:\n    raise ValueError(f\"Owner mismatch after init: {p}\")\n"
        ]
      },
      "api": {
        "image": "${BACKEND_IMAGE:?Set BACKEND_IMAGE (tag or digest)}",
        "labels": {
          "traefik.enable": "false"
        },
        "env_file": [
