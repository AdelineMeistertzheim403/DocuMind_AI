# Copy to .env.production; populate secrets locally. Never commit that file.
APP_HOST=documind.adelinemeistertzheim.fr
ACCOUNT_BASE_URL=https://documind.adelinemeistertzheim.fr
# Existing container name confirmed by the VPS administrator.
TRAEFIK_CONTAINER=traefik
POSTGRES_PASSWORD=
BFF_SERVICE_KEY=
# BFF_TRUSTED_PROXY_IPS is resolved on the VPS from the container above; no secret label.
LEGACY_API_ENABLED=false
REGISTRATION_MODE=disabled
OWNER_DEMO_ENABLED=false
AI_ENABLED=false
# Imposé également dans Compose ; aucun repli si le noyau refuse Landlock/seccomp.
EXTRACTION_MODE=sandbox
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_SESSION_TTL_SECONDS=1800
REQUESTS_PER_MINUTE=120
UPLOADS_PER_MINUTE=5
MAX_UPLOAD_BYTES=10485760
UPLOAD_MAX_CONCURRENT=2
UPLOAD_MAX_PER_OWNER=1
UPLOAD_MAX_PREFLIGHTS=8
UPLOAD_TEMP_BUDGET_BYTES=67108864
UPLOAD_MIN_FREE_BYTES=33554432
UPLOAD_AUTH_TIMEOUT_SECONDS=3
UPLOAD_READ_TIMEOUT_SECONDS=30
UPLOAD_IDLE_TIMEOUT_SECONDS=5
UPLOAD_TOTAL_TIMEOUT_SECONDS=75
MAX_DOCUMENTS_PER_OWNER=100
MAX_STORAGE_BYTES_PER_OWNER=524288000
MAX_STORAGE_BYTES_TOTAL=5368709120
AI_MAX_CONCURRENT_PER_OWNER=1
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.test
SMTP_STARTTLS=false
RESET_TTL_SECONDS=900
# Deployment admission in addition to filesystem quotas/monitoring. 41 GiB free reported.
DEPLOY_MIN_FREE_GIB=8

# Sprint 13 : préparation uniquement ; aucune admission publique par défaut.
# Le mode public exige BFF_SERVICE_KEY, LEGACY_API_ENABLED=false,
# OWNER_DEMO_ENABLED=false, SMTP TLS opérationnel et documents légaux approuvés.
PUBLIC_REGISTRATION_LIMIT=0
PUBLIC_REGISTRATION_PER_HOUR=3
PUBLIC_VERIFICATION_TTL_SECONDS=3600
PUBLIC_CHALLENGE_DIFFICULTY=12
PUBLIC_AI_MAX_BUDGET_USD=1
PUBLIC_LEGAL_READY=false
PUBLIC_OPERATOR_NAME=
PUBLIC_CONTACT_EMAIL=
PUBLIC_LEGAL_NOTICE_URL=
PUBLIC_PRIVACY_URL=
PUBLIC_TERMS_URL=
PUBLIC_TERMS_VERSION=
