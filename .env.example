# Copiez ce fichier en .env et définissez vos valeurs locales.
DATABASE_URL=postgresql+psycopg://documind:documind@localhost:5432/documind
# Objet JSON : clé secrète (32 caractères minimum) -> UUID du propriétaire.
# Aucune clé utilisable n'est fournie ; le serveur refuse de démarrer sans clé.
API_KEYS={}
STORAGE_DIR=var/documents
# Hors Docker uniquement : adaptateur portable NON confiné (Windows/bureau).
# Docker impose sandbox ; sur Linux natif, préférer sandbox avec Landlock ABI >= 3/libseccomp2.
EXTRACTION_MODE=development
API_PORT=8000
# Interface React et BFF (le navigateur ne reçoit aucune clé).
WEB_PORT=3000
BFF_PORT=3000
# Mode hors Docker : adapte automatiquement le port API_PORT si cette URL reste absente.
# BFF_BACKEND_URL=http://127.0.0.1:8001
# BFF_API_KEY=  # Obligatoire si API_KEYS contient plusieurs propriétaires.
MAX_UPLOAD_BYTES=10485760
UPLOAD_MAX_CONCURRENT=2
UPLOAD_MAX_PER_OWNER=1
UPLOAD_MAX_PREFLIGHTS=8
UPLOAD_TEMP_BUDGET_BYTES=67108864
UPLOAD_MIN_FREE_BYTES=33554432
UPLOAD_AUTH_TIMEOUT_SECONDS=3
UPLOAD_READ_TIMEOUT_SECONDS=30
UPLOAD_IDLE_TIMEOUT_SECONDS=5
UPLOAD_TOTAL_TIMEOUT_SECONDS=75
MAX_PDF_PAGES=200
MAX_TEXT_CHARS=1000000
WORKER_TIMEOUT_SECONDS=30
WORKER_MEMORY_MB=512
MAX_CONCURRENT_WORKERS=2
CHUNK_CHARS=1500
# Identifiants locaux PostgreSQL ; à changer pour tout autre environnement.
POSTGRES_USER=documind
POSTGRES_PASSWORD=documind
POSTGRES_DB=documind

# Sprint 3 : tout appel génératif reste désactivé par défaut.
AI_ENABLED=false
OWNER_DEMO_ENABLED=true
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
AI_BUDGET_USD=4
AI_SUMMARY_QUOTA=20
AI_QUESTION_QUOTA=100
AI_MAX_INPUT_TOKENS=16000
AI_MAX_OUTPUT_TOKENS=1200
# Compatibilité du moteur synchrone ; les tâches approfondies utilisent LONG_SUMMARY_*.
AI_MAX_SUMMARY_STEPS=5
AI_MAX_QUESTION_CHUNKS=5
AI_MAX_CONCURRENT_REQUESTS=2
AI_REQUESTS_PER_MINUTE=6
AI_TIMEOUT_SECONDS=30
AI_SESSION_TTL_SECONDS=1800
# Tarifs prudents contexte court standard, vérifiés le 19/10/2026.
# Entrée majorée à 0.25 pour inclure l'écriture de cache à 1.25x.
AI_PRICING_MODEL=gpt-5.6-luna
AI_INPUT_USD_PER_MILLION=0.25
AI_OUTPUT_USD_PER_MILLION=1.20
AI_PRICING_VERIFIED_ON=2026-10-19
# Secret serveur de liaison Caddy/BFF, à générer avant d'utiliser le profil HTTPS.
DOCUMIND_GATEWAY_TOKEN=

# Sprint 4 : aucun envoi automatique ; indexation et recherche vectorielle explicites.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_VERSION=chunks-v1
EMBEDDING_BATCH_SIZE=16
EMBEDDING_INPUT_USD_PER_MILLION=0.02
EMBEDDING_PRICING_MODEL=text-embedding-3-small
EMBEDDING_PRICING_VERIFIED_ON=2026-10-19
# Quotas cumulés par propriétaire ; l'indexation est comptée par lot fournisseur.
EMBEDDING_BATCH_QUOTA=500
RAG_SEARCH_QUOTA=200
RAG_QUESTION_QUOTA=100
RAG_COMPARISON_QUOTA=20
RAG_MAX_DOCUMENTS=10
RAG_MAX_PASSAGES=8
RAG_MAX_CHUNKS=10000
COMPARISON_MAX_CHARS=200000
COMPARISON_MAX_BLOCKS=2000

# Résumé approfondi : mêmes bornes par appel, arbre multi-niveaux et réservation globale.
LONG_SUMMARY_MAX_PARTS=128
LONG_SUMMARY_MAX_CALLS=255
LONG_SUMMARY_OVERLAP_CHARS=200
AI_MODEL_CONTEXT_TOKENS=128000
# Sprint 5: accounts remain local; registration is disabled until deliberately enabled.
LEGACY_API_ENABLED=true
BFF_SERVICE_KEY=
REGISTRATION_MODE=disabled
ACCOUNT_BASE_URL=https://localhost:8443
REQUESTS_PER_MINUTE=120
UPLOADS_PER_MINUTE=5
MAX_DOCUMENTS_PER_OWNER=100
MAX_STORAGE_BYTES_PER_OWNER=524288000
MAX_STORAGE_BYTES_TOTAL=5368709120
AI_MAX_CONCURRENT_PER_OWNER=1
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost
SMTP_STARTTLS=false
RESET_TTL_SECONDS=900
